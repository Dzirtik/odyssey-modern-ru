---
interface Props {
  status: "draft" | "editorial_preview" | "not_published";
}
const { status } = Astro.props;

const labels = {
  draft: "Сжатый черновой конспект",
  editorial_preview: "Редакционная превью-версия",
  not_published: "Не опубликовано",
};
---

<span class:list={["status-badge", status]}>
  {labels[status]}
</span>
