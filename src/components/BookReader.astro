---
import YAML from "yaml";
import ReadingControls from "./ReadingControls.astro";
import { project, withBase } from "../data/project";
import sourcesText from "../data/sources.yml?raw";

interface Props {
  book: any;
}

const { book } = Astro.props;
const number = String(book.book).padStart(2, "0");
const previous = book.book > 1 ? String(book.book - 1).padStart(2, "0") : "";
const next = book.book < 24 ? String(book.book + 1).padStart(2, "0") : "";
const notes = book.notes ?? [];
const sources = YAML.parse(sourcesText);
const semanticMapFiles = import.meta.glob(
  "../../editorial/semantic-map/book-*.yml",
  {
    eager: true,
    import: "default",
    query: "?raw",
  },
) as Record<string, string>;
const semanticMapPath = `../../editorial/semantic-map/book-${number}.yml`;
const semanticMap = semanticMapFiles[semanticMapPath]
  ? YAML.parse(semanticMapFiles[semanticMapPath])
  : { segments: [] };
const readerAnswerFiles = import.meta.glob(
  "../data/reader-answers/book-*.yml",
  {
    eager: true,
    import: "default",
    query: "?raw",
  },
) as Record<string, string>;
const readerAnswerPath = `../data/reader-answers/book-${number}.yml`;
const readerAnswers = readerAnswerFiles[readerAnswerPath]
  ? YAML.parse(readerAnswerFiles[readerAnswerPath])
  : [];
const normalizeQuestion = (value: string) =>
  value
    .trim()
    .toLocaleLowerCase("ru-RU")
    .replace(/[«»“”„"'`]/g, "")
    .replace(/[?.!,:;—–-]+$/g, "")
    .replace(/\s+/g, " ");
interface ReaderQuestion {
  text: string;
  noteId: string;
}
const questionsByRange = new Map<string, ReaderQuestion[]>(
  (semanticMap.segments ?? []).map((segment: any) => [
    segment.lines,
    (segment.reader_questions ?? []).map((question: string) => {
      const matchingNote = notes.find(
        (note: any) =>
          note.anchor &&
          note.anchor === `lines-${String(segment.lines)}` &&
          normalizeQuestion(note.title) === normalizeQuestion(question),
      );
      const matchingAnswer = readerAnswers.find(
        (answer: any) =>
          answer.anchor === `lines-${String(segment.lines)}` &&
          normalizeQuestion(answer.question) === normalizeQuestion(question),
      );
      return {
        text: question,
        noteId: matchingNote?.id ?? matchingAnswer?.answer_id ?? "",
      };
    }).filter((question: ReaderQuestion) => Boolean(question.noteId)),
  ]),
);
const sourceLabels = new Map(
  sources.map((source: any) => [
    source.id,
    `${source.author}. ${source.title}`,
  ]),
);
---

<article class="book-page" data-book={number}>
  <header class="book-header">
    <p class="eyebrow">
      Переложение · <a href={withBase("/sources/#homer_odyssey_perseus_grc2")}
        >{book.sourceRange}</a
      >
    </p>
    <h1>«Одиссея», {book.title}</h1>
  </header>

  <ReadingControls />
  <div class="reading-progress" aria-hidden="true"><span></span></div>

  <div class="reader-layout">
    <aside class="passage-nav" aria-label={`Навигация по ${book.title}`}>
      <p>{book.title}</p>
      <ol>
        {
          book.passages.map((passage: any) => (
            <li>
              <a href={`#${passage.id}`}>{passage.lines}</a>
            </li>
          ))
        }
      </ol>
    </aside>

    <div class="reader-copy">
      {
        book.passages.map((passage: any) => (
          <section
            id={passage.id}
            class="passage"
            data-line-end={passage.lineEnd}
          >
            <h2 class="line-range">
              {book.title}, строки {passage.lines}
            </h2>
            {passage.paragraphs.map((paragraph: string) => (
              <p>{paragraph}</p>
            ))}
            {(
              questionsByRange.get(`${passage.lineStart}-${passage.lineEnd}`) ??
              []
            ).length > 0 && (
              <aside
                class="reader-questions"
                aria-label={`Вопросы читателя к строкам ${passage.lines}`}
              >
                <p class="reader-questions-label">Вопросы читателя</p>
                <ul>
                  {(
                    questionsByRange.get(
                      `${passage.lineStart}-${passage.lineEnd}`,
                    ) ?? []
                  ).map((question: ReaderQuestion) => (
                    <li>
                      {question.text}
                      {question.noteId && (
                        <>
                          {" "}
                          <a href={`#${question.noteId}`}>открыть пояснение</a>
                        </>
                      )}
                    </li>
                  ))}
                </ul>
              </aside>
            )}
            {notes
              .filter((note: any) => note.anchor === passage.id)
              .map((note: any) => (
                <details class="note" id={note.id}>
                  <summary>
                    <span>{note.kind ?? "Пояснение"}</span>
                    {note.title}
                  </summary>
                  <div>
                    <p>{note.summary}</p>
                    <p>{note.details}</p>
                    <p class="note-meta">
                      {note.layer} · {note.confidence} · источники:{" "}
                      {note.sourceIds.map((source: string, index: number) => (
                        <>
                          {index > 0 && ", "}
                          <a href={withBase(`/sources/#${source}`)}>
                            {sourceLabels.get(source) ?? source}
                          </a>
                        </>
                      ))}
                    </p>
                  </div>
                </details>
              ))}
            {readerAnswers
              .filter((answer: any) => answer.anchor === passage.id)
              .map((answer: any) => (
                <details class="note reader-answer" id={answer.answer_id}>
                  <summary>
                    <span>Ответ читателю</span>
                    {answer.question}
                  </summary>
                  <div>
                    <p>{answer.summary}</p>
                    <p>{answer.details}</p>
                    <p class="note-meta">
                      {answer.layer} · {answer.confidence} · источники:{" "}
                      {answer.source_ids.map(
                        (source: string, index: number) => (
                          <>
                            {index > 0 && ", "}
                            <a href={withBase(`/sources/#${source}`)}>
                              {sourceLabels.get(source) ?? source}
                            </a>
                          </>
                        ),
                      )}
                    </p>
                  </div>
                </details>
              ))}
          </section>
        ))
      }
    </div>
  </div>

  <nav class="book-pagination" aria-label="Переход между песнями">
    {
      previous ? (
        <a href={withBase(`/book/${previous}/`)}>← Предыдущая</a>
      ) : (
        <a aria-disabled="true">← Предыдущая</a>
      )
    }
    <a href={withBase("/read/")}>Оглавление</a>
    {
      next ? (
        <a href={withBase(`/book/${next}/`)}>Следующая →</a>
      ) : (
        <a aria-disabled="true">Следующая →</a>
      )
    }
  </nav>

  <p class="report-link">
    <a
      href={`https://github.com/${project.owner}/${project.repository}/issues/new?template=content-error.yml&book=${number}`}
    >
      Сообщить об ошибке в {book.title}
    </a>
  </p>
</article>

<script>
  const article = document.querySelector<HTMLElement>(".book-page");
  const bookNumber = article?.dataset.book ?? "01";
  const progress = document.querySelector<HTMLElement>(
    ".reading-progress span",
  );
  const passages = [...document.querySelectorAll<HTMLElement>(".passage")];
  const storageKey = `odyssey-progress-book-${bookNumber}`;

  const update = () => {
    const main = document.querySelector<HTMLElement>(".reader-copy");
    if (!main || !progress) return;
    const rect = main.getBoundingClientRect();
    const total = main.offsetHeight - innerHeight;
    const read = Math.min(1, Math.max(0, -rect.top / Math.max(total, 1)));
    progress.style.width = `${read * 100}%`;
    const current = passages.findLast(
      (passage) => passage.getBoundingClientRect().top < innerHeight * 0.4,
    );
    if (current?.id) localStorage.setItem(storageKey, current.id);
  };

  addEventListener("scroll", update, { passive: true });
  update();
  const saved = localStorage.getItem(storageKey);
  if (!location.hash && saved) {
    document.getElementById(saved)?.scrollIntoView({ block: "start" });
  }

  const openTargetNote = () => {
    if (!location.hash) return;
    const target = document.querySelector<HTMLDetailsElement>(location.hash);
    if (target?.classList.contains("note")) target.open = true;
  };

  addEventListener("hashchange", openTargetNote);
  openTargetNote();
</script>
