---
import YAML from "yaml";
import BookAudioPlayer from "./BookAudioPlayer.astro";
import ReadingControls from "./ReadingControls.astro";
import { project, withBase } from "../data/project";
import sourcesText from "../data/sources.yml?raw";

interface Props {
  book: any;
}

const { book } = Astro.props;
const number = String(book.book).padStart(2, "0");
const previous = book.book > 1 ? String(book.book - 1).padStart(2, "0") : "";
const next = book.book < 24 ? String(book.book + 1).padStart(2, "0") : "";
const romanNumbers = [
  "I",
  "II",
  "III",
  "IV",
  "V",
  "VI",
  "VII",
  "VIII",
  "IX",
  "X",
  "XI",
  "XII",
  "XIII",
  "XIV",
  "XV",
  "XVI",
  "XVII",
  "XVIII",
  "XIX",
  "XX",
  "XXI",
  "XXII",
  "XXIII",
  "XXIV",
];
const notes = book.notes ?? [];
const sources = YAML.parse(sourcesText);
const readerAnswerFiles = import.meta.glob(
  "../data/reader-answers/book-*.yml",
  {
    eager: true,
    import: "default",
    query: "?raw",
  },
) as Record<string, string>;
const readerAnswerPath = `../data/reader-answers/book-${number}.yml`;
const readerAnswers = readerAnswerFiles[readerAnswerPath]
  ? YAML.parse(readerAnswerFiles[readerAnswerPath])
  : [];
const audioManifestFiles = import.meta.glob("../data/audio/book-*.json", {
  eager: true,
  import: "default",
}) as Record<string, any>;
const audioManifest =
  audioManifestFiles[`../data/audio/book-${number}.json`] ?? null;
const sourceLabels = new Map(
  sources.map((source: any) => [
    source.id,
    `${source.author}. ${source.title}`,
  ]),
);
const layerLabels: Record<string, string> = {
  POEM_WORLD: "Мир поэмы",
  ARCHAIC_CONTEXT: "Архаический контекст",
  MYCENAEAN_CONTEXT: "Микенский контекст",
  LATER_RECEPTION: "Позднейшая традиция",
  MODERN_HYPOTHESIS: "Современная гипотеза",
};
const confidenceLabels: Record<string, string> = {
  established: "надёжно подтверждено",
  probable: "вероятно",
  debated: "спорно",
  speculative: "предположение",
};
const labelLayer = (value: string) =>
  String(value)
    .split("+")
    .map((part) => layerLabels[part.trim()] ?? part.trim())
    .join(" · ");
const labelConfidence = (value: string) => confidenceLabels[value] ?? value;
const answerDetails = (value: string) =>
  String(value).replace(
    /\s*Ответ ограничен сведениями, открытыми в строках [^;]+;\s*дальнейшие эпизоды здесь не привлекаются\.$/u,
    "",
  );
---

<article class="book-page" data-book={number}>
  <header class="book-header">
    <p class="eyebrow">
      Переложение · <a href={withBase("/sources/#homer_odyssey_perseus_grc2")}
        >{book.sourceRange}</a
      >
    </p>
    <h1>«Одиссея», {book.title}</h1>
  </header>

  {
    audioManifest && (
      <div class="book-audio-wrap">
        <BookAudioPlayer
          bookNumber={audioManifest.book}
          title={audioManifest.title}
          source={`/audio/books/${audioManifest.file}`}
          durationSeconds={audioManifest.durationSeconds}
          disclosure={audioManifest.disclosure}
          nextHref={next ? `/book/${next}/` : "/read/"}
          nextLabel={
            next
              ? `Следующая: Песнь ${romanNumbers[book.book]} →`
              : "К оглавлению →"
          }
        />
      </div>
    )
  }

  <div class="reader-toolbar">
    <ReadingControls passages={book.passages} />
    <div
      class="reading-progress"
      role="progressbar"
      aria-label="Прочитано в этой песне"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <span></span>
    </div>
  </div>

  <div class="reader-layout">
    <aside class="passage-nav" aria-label={`Навигация по ${book.title}`}>
      <p>{book.title}</p>
      <ol>
        {
          book.passages.map((passage: any) => (
            <li>
              <a href={`#${passage.id}`} data-passage-link={passage.id}>
                {passage.lines}
              </a>
            </li>
          ))
        }
      </ol>
    </aside>

    <div class="reader-copy">
      {
        book.passages.map((passage: any) => {
          const passageNotes = notes.filter(
            (note: any) => note.anchor === passage.id,
          );
          const passageAnswers = readerAnswers.filter(
            (answer: any) => answer.anchor === passage.id,
          );
          return (
            <section
              id={passage.id}
              class="passage"
              data-line-end={passage.lineEnd}
              data-lines={passage.lines}
            >
              <h2 class="line-range">
                {book.title}, строки {passage.lines}
              </h2>
              {passage.paragraphs.map((paragraph: string) => (
                <p>{paragraph}</p>
              ))}
              {passageNotes.map((note: any) => (
                <details class="note editorial-note" id={note.id}>
                  <summary>
                    <span>{note.kind ?? "Пояснение"}</span>
                    {note.title}
                  </summary>
                  <div>
                    <p>{note.summary}</p>
                    <p>{note.details}</p>
                    <p class="note-meta">
                      {labelLayer(note.layer)} ·{" "}
                      {labelConfidence(note.confidence)} · источники:{" "}
                      {note.sourceIds.map((source: string, index: number) => (
                        <>
                          {index > 0 && ", "}
                          <a href={withBase(`/sources/#${source}`)}>
                            {sourceLabels.get(source) ?? source}
                          </a>
                        </>
                      ))}
                    </p>
                  </div>
                </details>
              ))}
              {passageAnswers.length > 0 && (
                <details class="reader-answers">
                  <summary>
                    <span>Автоматизированные ответы к фрагменту</span>
                    <strong>{passageAnswers.length}</strong>
                  </summary>
                  <p class="reader-answers-disclosure">
                    Эти ответы не проходили существенную проверку человеком.
                  </p>
                  {passageAnswers.map((answer: any) => (
                    <details class="note reader-answer" id={answer.answer_id}>
                      <summary>
                        <span>Ответ читателю</span>
                        {answer.question}
                      </summary>
                      <div>
                        <p>{answer.summary}</p>
                        <p>{answerDetails(answer.details)}</p>
                        <details class="answer-sources">
                          <summary>Основание и источники</summary>
                          <p class="note-meta">
                            {labelLayer(answer.layer)} ·{" "}
                            {labelConfidence(answer.confidence)} ·{" "}
                            {answer.source_ids.map(
                              (source: string, index: number) => (
                                <>
                                  {index > 0 && ", "}
                                  <a href={withBase(`/sources/#${source}`)}>
                                    {sourceLabels.get(source) ?? source}
                                  </a>
                                </>
                              ),
                            )}
                          </p>
                        </details>
                      </div>
                    </details>
                  ))}
                </details>
              )}
            </section>
          );
        })
      }
    </div>
  </div>

  <div
    class="reading-complete-sentinel"
    data-reading-complete
    aria-hidden="true"
  >
  </div>

  <nav class="book-pagination" aria-label="Переход между песнями">
    {
      previous ? (
        <a href={withBase(`/book/${previous}/`)}>← Предыдущая</a>
      ) : (
        <span class="disabled">← Предыдущая</span>
      )
    }
    <a href={withBase("/read/")}>Оглавление</a>
    {
      next ? (
        <a href={withBase(`/book/${next}/`)}>Следующая →</a>
      ) : (
        <span class="disabled">Следующая →</span>
      )
    }
  </nav>

  <p class="report-link">
    <a
      href={`https://github.com/${project.owner}/${project.repository}/issues/new?template=content-error.yml&book=${number}`}
    >
      Сообщить об ошибке в {book.title}
    </a>
  </p>
</article>

<script>
  import { completeBook, saveReaderPosition } from "../scripts/reader-state";

  const article = document.querySelector<HTMLElement>(".book-page");
  const bookNumber = Number(article?.dataset.book);
  const progressBar = document.querySelector<HTMLElement>(".reading-progress");
  const progress = document.querySelector<HTMLElement>(
    ".reading-progress span",
  );
  const progressStatus = document.querySelector<HTMLElement>(
    "[data-progress-status]",
  );
  const passageSelect = document.querySelector<HTMLSelectElement>(
    "[data-passage-select]",
  );
  const passages = [...document.querySelectorAll<HTMLElement>(".passage")];
  const passageLinks = [
    ...document.querySelectorAll<HTMLAnchorElement>("[data-passage-link]"),
  ];
  const completionSentinel = document.querySelector<HTMLElement>(
    "[data-reading-complete]",
  );
  let animationFrame = 0;
  let pendingPersist = false;
  let lastPassageId = "";
  let hasReadingIntent = Boolean(location.hash);

  const markReadingIntent = () => {
    hasReadingIntent = true;
  };
  addEventListener("wheel", markReadingIntent, { passive: true });
  addEventListener("touchmove", markReadingIntent, { passive: true });
  addEventListener("pointerdown", markReadingIntent, { passive: true });
  addEventListener("keydown", (event) => {
    if (
      [
        "ArrowDown",
        "ArrowUp",
        "PageDown",
        "PageUp",
        "End",
        "Home",
        " ",
      ].includes(event.key)
    ) {
      markReadingIntent();
    }
  });

  const recordCompletion = () => {
    if (!Number.isInteger(bookNumber)) return;
    completeBook(bookNumber);
  };

  const update = (persist = false) => {
    const main = document.querySelector<HTMLElement>(".reader-copy");
    if (!main || !progress) return;
    const rect = main.getBoundingClientRect();
    const total = main.offsetHeight - innerHeight;
    const read = Math.min(1, Math.max(0, -rect.top / Math.max(total, 1)));
    const percentage = Math.round(read * 100);
    progress.style.width = `${percentage}%`;
    progressBar?.setAttribute("aria-valuenow", String(percentage));
    const current =
      passages.findLast(
        (passage) => passage.getBoundingClientRect().top < innerHeight * 0.4,
      ) ?? passages[0];
    if (!current?.id) return;
    if (persist && Number.isInteger(bookNumber)) {
      saveReaderPosition(bookNumber, current.id);
    }
    if (passageSelect) passageSelect.value = current.id;
    if (progressStatus) {
      progressStatus.textContent = `${percentage}% · строки ${current.dataset.lines}`;
    }
    if (lastPassageId !== current.id) {
      lastPassageId = current.id;
      passageLinks.forEach((link) => {
        if (link.dataset.passageLink === current.id) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    }
    if (
      completionSentinel &&
      completionSentinel.getBoundingClientRect().top <= innerHeight
    ) {
      recordCompletion();
    }
  };

  const scheduleUpdate = (persist = false) => {
    pendingPersist ||= persist;
    if (animationFrame) return;
    animationFrame = requestAnimationFrame(() => {
      animationFrame = 0;
      const shouldPersist = pendingPersist;
      pendingPersist = false;
      update(shouldPersist);
    });
  };
  addEventListener("scroll", () => scheduleUpdate(hasReadingIntent), {
    passive: true,
  });
  document.addEventListener("toggle", () => scheduleUpdate(false), true);
  update(false);

  const hashTarget = () => {
    if (!location.hash) return null;
    try {
      return document.getElementById(
        decodeURIComponent(location.hash.slice(1)),
      );
    } catch {
      return null;
    }
  };

  const openTargetNote = () => {
    const target = hashTarget();
    if (!target?.classList.contains("note")) return;
    const note = target as HTMLDetailsElement;
    note.open = true;
    const answerGroup = target.closest<HTMLDetailsElement>(".reader-answers");
    if (answerGroup) answerGroup.open = true;
  };

  const focusTargetPassage = () => {
    const target = hashTarget();
    if (!target?.classList.contains("passage")) return;
    const heading = target.querySelector<HTMLElement>("h2");
    if (!heading) return;
    heading.tabIndex = -1;
    heading.focus({ preventScroll: true });
  };

  addEventListener("hashchange", () => {
    markReadingIntent();
    openTargetNote();
    focusTargetPassage();
    scheduleUpdate(true);
  });
  addEventListener("odyssey:passage-selected", markReadingIntent);
  openTargetNote();
  requestAnimationFrame(() => {
    focusTargetPassage();
    update(Boolean(location.hash));
  });

  if (completionSentinel && "IntersectionObserver" in window) {
    new IntersectionObserver(
      (entries, observer) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        recordCompletion();
        observer.disconnect();
      },
      { threshold: 1 },
    ).observe(completionSentinel);
  }
</script>

<style>
  .book-audio-wrap {
    width: min(90rem, calc(100% - 2.5rem));
    margin: 0 auto;
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
</style>
