---
import YAML from "yaml";
import ReadingControls from "./ReadingControls.astro";
import { project, withBase } from "../data/project";
import sourcesText from "../data/sources.yml?raw";

interface Props {
  book: any;
}

const { book } = Astro.props;
const number = String(book.book).padStart(2, "0");
const previous = book.book > 1 ? String(book.book - 1).padStart(2, "0") : "";
const next = book.book < 24 ? String(book.book + 1).padStart(2, "0") : "";
const notes = book.notes ?? [];
const sources = YAML.parse(sourcesText);
const readerAnswerFiles = import.meta.glob(
  "../data/reader-answers/book-*.yml",
  {
    eager: true,
    import: "default",
    query: "?raw",
  },
) as Record<string, string>;
const readerAnswerPath = `../data/reader-answers/book-${number}.yml`;
const readerAnswers = readerAnswerFiles[readerAnswerPath]
  ? YAML.parse(readerAnswerFiles[readerAnswerPath])
  : [];
const sourceLabels = new Map(
  sources.map((source: any) => [
    source.id,
    `${source.author}. ${source.title}`,
  ]),
);
const layerLabels: Record<string, string> = {
  POEM_WORLD: "Мир поэмы",
  ARCHAIC_CONTEXT: "Архаический контекст",
  MYCENAEAN_CONTEXT: "Микенский контекст",
  LATER_RECEPTION: "Позднейшая традиция",
  MODERN_HYPOTHESIS: "Современная гипотеза",
};
const confidenceLabels: Record<string, string> = {
  established: "надёжно подтверждено",
  probable: "вероятно",
  debated: "спорно",
  speculative: "предположение",
};
const labelLayer = (value: string) =>
  String(value)
    .split("+")
    .map((part) => layerLabels[part.trim()] ?? part.trim())
    .join(" · ");
const labelConfidence = (value: string) =>
  confidenceLabels[value] ?? value;
const answerDetails = (value: string) =>
  String(value).replace(
    /\s*Ответ ограничен сведениями, открытыми в строках [^;]+;\s*дальнейшие эпизоды здесь не привлекаются\.$/u,
    "",
  );
---

<article class="book-page" data-book={number}>
  <header class="book-header">
    <p class="eyebrow">
      Переложение · <a href={withBase("/sources/#homer_odyssey_perseus_grc2")}
        >{book.sourceRange}</a
      >
    </p>
    <h1>«Одиссея», {book.title}</h1>
  </header>

  <div class="reader-toolbar">
    <ReadingControls passages={book.passages} />
    <div
      class="reading-progress"
      role="progressbar"
      aria-label="Прочитано в этой песне"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <span></span>
    </div>
  </div>

  <div class="reader-layout">
    <aside class="passage-nav" aria-label={`Навигация по ${book.title}`}>
      <p>{book.title}</p>
      <ol>
        {
          book.passages.map((passage: any) => (
            <li>
              <a href={`#${passage.id}`}>{passage.lines}</a>
            </li>
          ))
        }
      </ol>
    </aside>

    <div class="reader-copy">
      {
        book.passages.map((passage: any) => {
          const passageNotes = notes.filter(
            (note: any) => note.anchor === passage.id,
          );
          const passageAnswers = readerAnswers.filter(
            (answer: any) => answer.anchor === passage.id,
          );
          return (
            <section
              id={passage.id}
              class="passage"
              data-line-end={passage.lineEnd}
              data-lines={passage.lines}
            >
              <h2 class="line-range">
                {book.title}, строки {passage.lines}
              </h2>
              {passage.paragraphs.map((paragraph: string) => (
                <p>{paragraph}</p>
              ))}
              {passageNotes.map((note: any) => (
                <details class="note editorial-note" id={note.id}>
                  <summary>
                    <span>{note.kind ?? "Пояснение"}</span>
                    {note.title}
                  </summary>
                  <div>
                    <p>{note.summary}</p>
                    <p>{note.details}</p>
                    <p class="note-meta">
                      {labelLayer(note.layer)} ·{" "}
                      {labelConfidence(note.confidence)} · источники:{" "}
                      {note.sourceIds.map((source: string, index: number) => (
                        <>
                          {index > 0 && ", "}
                          <a href={withBase(`/sources/#${source}`)}>
                            {sourceLabels.get(source) ?? source}
                          </a>
                        </>
                      ))}
                    </p>
                  </div>
                </details>
              ))}
              {passageAnswers.length > 0 && (
                <details class="reader-answers">
                  <summary>
                    <span>Ответы на вопросы к этому фрагменту</span>
                    <strong>{passageAnswers.length}</strong>
                  </summary>
                  {passageAnswers.map((answer: any) => (
                    <details
                      class="note reader-answer"
                      id={answer.answer_id}
                    >
                      <summary>
                        <span>Ответ читателю</span>
                        {answer.question}
                      </summary>
                      <div>
                        <p>{answer.summary}</p>
                        <p>{answerDetails(answer.details)}</p>
                        <details class="answer-sources">
                          <summary>Основание и источники</summary>
                          <p class="note-meta">
                            {labelLayer(answer.layer)} ·{" "}
                            {labelConfidence(answer.confidence)} ·{" "}
                            {answer.source_ids.map(
                              (source: string, index: number) => (
                                <>
                                  {index > 0 && ", "}
                                  <a href={withBase(`/sources/#${source}`)}>
                                    {sourceLabels.get(source) ?? source}
                                  </a>
                                </>
                              ),
                            )}
                          </p>
                        </details>
                      </div>
                    </details>
                  ))}
                </details>
              )}
            </section>
          );
        })
      }
    </div>
  </div>

  <nav class="book-pagination" aria-label="Переход между песнями">
    {
      previous ? (
        <a href={withBase(`/book/${previous}/`)}>← Предыдущая</a>
      ) : (
        <a aria-disabled="true">← Предыдущая</a>
      )
    }
    <a href={withBase("/read/")}>Оглавление</a>
    {
      next ? (
        <a href={withBase(`/book/${next}/`)}>Следующая →</a>
      ) : (
        <a aria-disabled="true">Следующая →</a>
      )
    }
  </nav>

  <p class="report-link">
    <a
      href={`https://github.com/${project.owner}/${project.repository}/issues/new?template=content-error.yml&book=${number}`}
    >
      Сообщить об ошибке в {book.title}
    </a>
  </p>
</article>

<script>
  const article = document.querySelector<HTMLElement>(".book-page");
  const bookNumber = article?.dataset.book ?? "01";
  const progressBar = document.querySelector<HTMLElement>(".reading-progress");
  const progress = document.querySelector<HTMLElement>(
    ".reading-progress span",
  );
  const progressStatus = document.querySelector<HTMLOutputElement>(
    "[data-progress-status]",
  );
  const passageSelect = document.querySelector<HTMLSelectElement>(
    "[data-passage-select]",
  );
  const passages = [...document.querySelectorAll<HTMLElement>(".passage")];
  const storageKey = `odyssey-progress-book-${bookNumber}`;
  localStorage.setItem("odyssey-last-book", String(Number(bookNumber)));

  const update = () => {
    const main = document.querySelector<HTMLElement>(".reader-copy");
    if (!main || !progress) return;
    const rect = main.getBoundingClientRect();
    const total = main.offsetHeight - innerHeight;
    const read = Math.min(1, Math.max(0, -rect.top / Math.max(total, 1)));
    const percentage = Math.round(read * 100);
    progress.style.width = `${percentage}%`;
    progressBar?.setAttribute("aria-valuenow", String(percentage));
    const current =
      passages.findLast(
        (passage) => passage.getBoundingClientRect().top < innerHeight * 0.4,
      ) ?? passages[0];
    if (!current?.id) return;
    localStorage.setItem(storageKey, current.id);
    if (passageSelect) passageSelect.value = current.id;
    if (progressStatus) {
      progressStatus.value = `${percentage}% · строки ${current.dataset.lines}`;
    }

    const lastPassage = passages.at(-1);
    if (current === lastPassage) {
      const currentBook = Number(bookNumber);
      const revealedBook = Number(
        localStorage.getItem("odyssey-max-book") ?? 1,
      );
      if (currentBook === revealedBook + 1) {
        localStorage.setItem("odyssey-max-book", String(currentBook));
      }
    }
  };

  addEventListener("scroll", update, { passive: true });
  update();

  const openTargetNote = () => {
    if (!location.hash) return;
    const target = document.querySelector<HTMLDetailsElement>(location.hash);
    if (!target?.classList.contains("note")) return;
    target.open = true;
    const answerGroup = target.closest<HTMLDetailsElement>(".reader-answers");
    if (answerGroup) answerGroup.open = true;
  };

  addEventListener("hashchange", () => {
    openTargetNote();
    requestAnimationFrame(update);
  });
  openTargetNote();
  requestAnimationFrame(update);
</script>
