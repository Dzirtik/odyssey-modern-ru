<div class="reference-controls">
  <p data-reference-status role="status" aria-live="polite">
    По умолчанию показаны только сведения, доступные к вашему пределу чтения.
  </p>
  <button type="button" data-show-all-references aria-expanded="false">
    Показать всё — возможны спойлеры
  </button>
</div>

<script>
  const button = document.querySelector<HTMLButtonElement>(
    "[data-show-all-references]",
  );
  const status = document.querySelector<HTMLElement>("[data-reference-status]");
  const initialHiddenState = new Map<HTMLElement, boolean>();
  let isShowingAll = false;

  button?.addEventListener("click", () => {
    const references = document.querySelectorAll<HTMLElement>(
      "main [data-reveal-book]",
    );

    if (!isShowingAll) {
      references.forEach((element) => {
        if (!initialHiddenState.has(element)) {
          initialHiddenState.set(element, element.hasAttribute("hidden"));
        }
        element.hidden = false;
      });

      isShowingAll = true;
      button.textContent = "Скрыть будущие сведения";
      button.setAttribute("aria-expanded", "true");
      if (status) {
        status.textContent = "Показан полный справочник · возможны спойлеры.";
      }
      return;
    }

    references.forEach((element) => {
      element.hidden = initialHiddenState.get(element) ?? true;
    });

    isShowingAll = false;
    button.textContent = "Показать всё — возможны спойлеры";
    button.setAttribute("aria-expanded", "false");
    if (status) {
      status.textContent =
        "Снова показаны только сведения, доступные к вашему пределу чтения.";
    }
  });
</script>
