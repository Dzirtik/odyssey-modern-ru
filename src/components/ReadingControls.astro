<section class="reading-controls" aria-label="Настройки чтения">
  <div>
    <span>Размер текста</span>
    <button type="button" data-font="minus" aria-label="Уменьшить текст">А−</button>
    <button type="button" data-font="plus" aria-label="Увеличить текст">А+</button>
  </div>
  <label>
    <span>Ширина строки</span>
    <input type="range" min="34" max="76" value="64" step="2" data-width />
  </label>
</section>

<script>
  const root = document.documentElement;
  const savedScale = Number(localStorage.getItem("odyssey-font-scale") ?? 1);
  const savedWidth = Number(localStorage.getItem("odyssey-line-width") ?? 64);
  const width = document.querySelector<HTMLInputElement>("[data-width]");

  const applyScale = (value: number) => {
    const safe = Math.min(1.35, Math.max(0.9, value));
    root.style.setProperty("--reader-scale", String(safe));
    localStorage.setItem("odyssey-font-scale", String(safe));
  };
  const applyWidth = (value: number) => {
    root.style.setProperty("--reader-width", `${value}ch`);
    localStorage.setItem("odyssey-line-width", String(value));
    if (width) width.value = String(value);
  };

  applyScale(savedScale);
  applyWidth(savedWidth);
  document.querySelector("[data-font='minus']")?.addEventListener("click", () => {
    applyScale(Number(localStorage.getItem("odyssey-font-scale") ?? 1) - 0.05);
  });
  document.querySelector("[data-font='plus']")?.addEventListener("click", () => {
    applyScale(Number(localStorage.getItem("odyssey-font-scale") ?? 1) + 0.05);
  });
  width?.addEventListener("input", () => applyWidth(Number(width.value)));
</script>
