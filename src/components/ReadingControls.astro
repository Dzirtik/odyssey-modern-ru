---
interface Props {
  passages: Array<{ id: string; lines: string }>;
}

const { passages } = Astro.props;
---

<section class="reading-controls" aria-label="Навигация и настройки чтения">
  <label class="passage-picker">
    <span>Фрагмент</span>
    <select data-passage-select aria-label="Перейти к фрагменту">
      {
        passages.map((passage) => (
          <option value={passage.id}>{passage.lines}</option>
        ))
      }
    </select>
  </label>
  <div class="font-control">
    <span>Текст</span>
    <button type="button" data-font="minus" aria-label="Уменьшить текст">
      А−
    </button>
    <output data-font-status aria-label="Текущий размер текста">100%</output>
    <button type="button" data-font="plus" aria-label="Увеличить текст">
      А+
    </button>
  </div>
  <label class="width-control">
    <span>Строка</span>
    <input
      type="range"
      min="34"
      max="76"
      value="64"
      step="2"
      data-width
      aria-label="Ширина строки в знаках"
    />
    <output data-width-status>64 знака</output>
  </label>
  <span class="progress-status" data-progress-status aria-live="off">
    0% · начало песни
  </span>
</section>

<script>
  import {
    readNumberPreference,
    writePreference,
  } from "../scripts/reader-state";

  const root = document.documentElement;
  const savedScale = readNumberPreference("odyssey-font-scale", 1, 1, 1.35);
  const savedWidth = readNumberPreference("odyssey-line-width", 64, 34, 76);
  const width = document.querySelector<HTMLInputElement>("[data-width]");
  const fontStatus =
    document.querySelector<HTMLOutputElement>("[data-font-status]");
  const widthStatus = document.querySelector<HTMLOutputElement>(
    "[data-width-status]",
  );
  const passageSelect = document.querySelector<HTMLSelectElement>(
    "[data-passage-select]",
  );

  const applyScale = (value: number) => {
    const safe = Math.min(1.35, Math.max(1, value));
    root.style.setProperty("--reader-scale", String(safe));
    writePreference("odyssey-font-scale", String(safe));
    if (fontStatus) fontStatus.value = `${Math.round(safe * 100)}%`;
  };
  const applyWidth = (value: number) => {
    const safe = Math.min(76, Math.max(34, value));
    root.style.setProperty("--reader-width", `${safe}ch`);
    writePreference("odyssey-line-width", String(safe));
    if (width) width.value = String(safe);
    if (widthStatus) widthStatus.value = `${safe} знака`;
  };

  applyScale(savedScale);
  applyWidth(savedWidth);
  document
    .querySelector("[data-font='minus']")
    ?.addEventListener("click", () => {
      const current = readNumberPreference("odyssey-font-scale", 1, 1, 1.35);
      applyScale(current - 0.05);
    });
  document
    .querySelector("[data-font='plus']")
    ?.addEventListener("click", () => {
      const current = readNumberPreference("odyssey-font-scale", 1, 1, 1.35);
      applyScale(current + 0.05);
    });
  width?.addEventListener("input", () => applyWidth(Number(width.value)));
  passageSelect?.addEventListener("change", () => {
    dispatchEvent(
      new CustomEvent("odyssey:passage-selected", {
        detail: { passageId: passageSelect.value },
      }),
    );
    location.hash = passageSelect.value;
  });

  const toolbar = document.querySelector<HTMLElement>(".reader-toolbar");
  const updateToolbarHeight = () => {
    if (!toolbar) return;
    root.style.setProperty(
      "--reader-toolbar-height",
      `${Math.ceil(toolbar.getBoundingClientRect().height)}px`,
    );
  };
  updateToolbarHeight();
  if (toolbar && "ResizeObserver" in window) {
    new ResizeObserver(updateToolbarHeight).observe(toolbar);
  }
</script>
