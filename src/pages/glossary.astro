---
import YAML from "yaml";
import BaseLayout from "../layouts/BaseLayout.astro";
import ReferenceControls from "../components/ReferenceControls.astro";
import glossaryText from "../data/glossary.yml?raw";
import { project, withBase } from "../data/project";

interface GlossaryEntry {
  term: string;
  first_book: number;
  greek: string;
  category: string;
  definition: string;
}

const glossary = YAML.parse(glossaryText) as GlossaryEntry[];
const breadcrumbs = [
  { name: "Главная", href: withBase("/") },
  { name: "Словарь" },
];
---

<BaseLayout
  title="Словарь «Одиссеи» Гомера"
  description="Безспойлерный словарь терминов и понятий мира «Одиссеи» Гомера: ахейцы, ксения, агора, басилевс и другие слова по мере чтения."
  pageType="CollectionPage"
  dateModified={project.lastChecked}
  {breadcrumbs}
>
  <section class="page-intro">
    <p class="eyebrow" data-progress-label>Прогрессивный словарь</p>
    <h1>{glossary.length} слов мира поэмы</h1>
    <p>
      Социальные, ритуальные, повествовательные и предметные понятия объясняются
      в значении, важном для конкретных сцен «Одиссеи». Формы проверяются по <a
        href={withBase("/sources/#homer_odyssey_perseus_grc2")}
        >греческому тексту</a
      >, <a href={withBase("/sources/#de_jong_2001")}>комментарию</a> и профильным
      источникам реестра.
    </p>
  </section>
  <ReferenceControls />
  <dl class="glossary">
    {
      glossary.map((entry) => (
        <div
          data-reveal-book={entry.first_book}
          data-nosnippet={entry.first_book > 1 ? true : undefined}
          hidden={entry.first_book > 1}
        >
          <dt>
            {entry.term}
            {entry.greek && <span lang="grc">{entry.greek}</span>}
          </dt>
          <dd>
            <span class="glossary-category">
              {entry.category} · впервые в Песни {entry.first_book}
            </span>
            {entry.definition}
          </dd>
        </div>
      ))
    }
  </dl>
</BaseLayout>
