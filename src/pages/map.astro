---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Карта">
  <section class="page-intro">
    <p class="eyebrow">Карта названных мест · предел Песни I</p>
    <h1>Пространство, уже открытое текстом</h1>
    <p>Схема намеренно не прокладывает будущий маршрут и не отождествляет спорные места с современными точками.</p>
  </section>
  <div class="text-map" role="img" aria-label="Условная схема уже названных в Песни I мест">
    <span style="--x:14%;--y:36%">Огигия</span>
    <span style="--x:47%;--y:48%">Итака</span>
    <span style="--x:66%;--y:25%">Пилос</span>
    <span style="--x:77%;--y:55%">Спарта</span>
    <span style="--x:89%;--y:30%">Троя</span>
  </div>
</BaseLayout>
