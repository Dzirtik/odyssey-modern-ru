---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BookReader from "../../components/BookReader.astro";
import { bookOne } from "../../data/book-one";
import { previewBookByNumber } from "../../data/books-preview.mjs";

export function getStaticPaths() {
  return Array.from({ length: 24 }, (_, index) => ({
    params: { book: String(index + 1).padStart(2, "0") },
    props: { book: index + 1 }
  }));
}

interface Props { book: number }
const { book } = Astro.props;
const roman = ["I","II","III","IV","V","VI","VII","VIII","IX","X","XI","XII","XIII","XIV","XV","XVI","XVII","XVIII","XIX","XX","XXI","XXII","XXIII","XXIV"][book - 1];
const content = book === 1 ? bookOne : previewBookByNumber.get(book);
---

<BaseLayout title={`Песнь ${roman}`}>
  {content && <BookReader book={content} />}
</BaseLayout>
