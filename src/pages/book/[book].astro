---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BookReader from "../../components/BookReader.astro";
import { bookOne } from "../../data/book-one";
import { bookTwo } from "../../data/book-two";
import { bookThree } from "../../data/book-three";
import { bookFour } from "../../data/book-four";
import { bookFive } from "../../data/book-five";
import { bookSix } from "../../data/book-six";
import { bookSeven } from "../../data/book-seven";
import { bookEight } from "../../data/book-eight";
import { bookNine } from "../../data/book-nine";
import { bookTen } from "../../data/book-ten";
import { bookEleven } from "../../data/book-eleven";
import { bookTwelve } from "../../data/book-twelve";
import { bookThirteen } from "../../data/book-thirteen";
import { bookFourteen } from "../../data/book-fourteen";
import { bookFifteen } from "../../data/book-fifteen";
import { bookSixteen } from "../../data/book-sixteen";
import { bookSeventeen } from "../../data/book-seventeen";
import { bookEighteen } from "../../data/book-eighteen";
import { bookNineteen } from "../../data/book-nineteen";
import { bookTwenty } from "../../data/book-twenty";
import { bookTwentyOne } from "../../data/book-twenty-one";
import { bookTwentyTwo } from "../../data/book-twenty-two";
import { bookTwentyThree } from "../../data/book-twenty-three";
import { bookTwentyFour } from "../../data/book-twenty-four";
import { project, withBase } from "../../data/project";

export function getStaticPaths() {
  return Array.from({ length: 24 }, (_, index) => ({
    params: { book: String(index + 1).padStart(2, "0") },
    props: { book: index + 1 },
  }));
}

interface Props {
  book: number;
}
const { book }: Props = Astro.props;
const roman = [
  "I",
  "II",
  "III",
  "IV",
  "V",
  "VI",
  "VII",
  "VIII",
  "IX",
  "X",
  "XI",
  "XII",
  "XIII",
  "XIV",
  "XV",
  "XVI",
  "XVII",
  "XVIII",
  "XIX",
  "XX",
  "XXI",
  "XXII",
  "XXIII",
  "XXIV",
][book - 1];
const content =
  book === 1
    ? bookOne
    : book === 2
      ? bookTwo
      : book === 3
        ? bookThree
        : book === 4
          ? bookFour
          : book === 5
            ? bookFive
            : book === 6
              ? bookSix
              : book === 7
                ? bookSeven
                : book === 8
                  ? bookEight
                  : book === 9
                    ? bookNine
                    : book === 10
                      ? bookTen
                      : book === 11
                        ? bookEleven
                        : book === 12
                          ? bookTwelve
                          : book === 13
                            ? bookThirteen
                            : book === 14
                              ? bookFourteen
                              : book === 15
                                ? bookFifteen
                                : book === 16
                                  ? bookSixteen
                                  : book === 17
                                    ? bookSeventeen
                                    : book === 18
                                      ? bookEighteen
                                      : book === 19
                                        ? bookNineteen
                                        : book === 20
                                          ? bookTwenty
                                          : book === 21
                                            ? bookTwentyOne
                                            : book === 22
                                              ? bookTwentyTwo
                                              : book === 23
                                              ? bookTwentyThree
                                                : bookTwentyFour;
const number = String(book).padStart(2, "0");
const audioManifestFiles = import.meta.glob(
  "../../data/audio/book-*.json",
  {
    eager: true,
    import: "default",
  },
) as Record<string, any>;
const audioManifest =
  audioManifestFiles[`../../data/audio/book-${number}.json`] ?? null;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const siteURL = new URL(withBase("/"), Astro.site ?? Astro.url);
const rightsURL = new URL(withBase("/rights/"), Astro.site ?? Astro.url);
const audioURL = new URL(
  withBase(`/audio/books/${audioManifest?.file ?? ""}`),
  Astro.site ?? Astro.url,
);
const lineCount = content.passages.at(-1)?.lineEnd ?? 0;
const description =
  audioManifest
    ? `«Одиссея» Гомера, Песнь ${roman}: современное русское переложение ${lineCount} строк с пояснениями и полной многоголосной аудиоверсией.`
    : `«Одиссея» Гомера, Песнь ${roman}: современное русское прозаическое переложение ${lineCount} строк с построчной сверкой и ${content.notes.length} пояснениями.`;
const audioId = `${canonicalURL.href}#audio-edition`;
const audioDuration = audioManifest
  ? `PT${Math.floor(audioManifest.durationSeconds / 60)}M${Math.round(audioManifest.durationSeconds % 60)}S`
  : "";
const structuredData = [
  {
    "@type": "Chapter",
    "@id": `${canonicalURL.href}#chapter`,
    url: canonicalURL.href,
    name: `«Одиссея» Гомера, Песнь ${roman}`,
    position: book,
    inLanguage: "ru-RU",
    author: {
      "@type": "Person",
      name: "Гомер",
    },
    contributor: { "@id": `${siteURL.href}#publisher` },
    isAccessibleForFree: true,
    datePublished: project.firstPublished,
    dateModified: content.lastFactCheck,
    license: rightsURL.href,
    isPartOf: { "@id": `${siteURL.href}#odyssey` },
    ...(audioManifest ? { associatedMedia: { "@id": audioId } } : {}),
  },
  ...(audioManifest
    ? [
        {
          "@type": "AudioObject",
          "@id": audioId,
          name: `Многоголосная аудиоверсия Песни ${roman}`,
          contentUrl: audioURL.href,
          encodingFormat: "audio/mpeg",
          duration: audioDuration,
          inLanguage: "ru-RU",
          isAccessibleForFree: true,
          license: rightsURL.href,
          isPartOf: { "@id": `${canonicalURL.href}#chapter` },
        },
      ]
    : []),
];
const breadcrumbs = [
  { name: "Главная", href: withBase("/") },
  { name: "Читать", href: withBase("/read/") },
  { name: `Песнь ${roman}` },
];
---

<BaseLayout
  title={`Песнь ${roman} «Одиссеи» Гомера — читать`}
  {description}
  ogType="article"
  dateModified={content.lastFactCheck}
  {structuredData}
  {breadcrumbs}
>
  {content && <BookReader book={content} />}
</BaseLayout>
