---
import BaseLayout from "../layouts/BaseLayout.astro";
import { project, withBase } from "../data/project";
---

<BaseLayout
  description="Читайте «Одиссею» Гомера в современном русском прозаическом переложении: 24 песни, построчная сверка, 156 пояснений, источники и открытая методология."
  dateModified={project.lastChecked}
>
  <section class="hero">
    <div>
      <p class="eyebrow">Независимый редакционный проект</p>
      <h1>«Одиссея» Гомера.<br /><em>Текст — заново.</em></h1>
      <p class="lead">
        Полное по охвату строк, сжатое современное прозаическое переложение
        «Одиссеи» с пояснениями и проверяемыми источниками.
      </p>
      <div class="hero-actions">
        <a
          class="button primary"
          href={withBase("/book/01/")}
          data-resume-link
          data-book-base={withBase("/book/")}
          >Начать Песнь I</a
        >
        <a class="button secondary" href="#before-reading">Что важно знать</a>
      </div>
    </div>
    <div class="hero-mark" aria-hidden="true">
      <span>α</span><span>ω</span>
      <p>24 песни<br />12 110 строк</p>
    </div>
  </section>

  <section
    id="before-reading"
    class="reader-onboarding"
    aria-labelledby="before-reading-title"
  >
    <div>
      <p class="eyebrow">Перед чтением</p>
      <h2 id="before-reading-title">Можно начинать без подготовки</h2>
      <p class="onboarding-lead">
        Поэма начинается после Троянской войны, но заранее изучать мифы не
        нужно: имена, обычаи и неочевидные связи объясняются там, где впервые
        становятся важны.
      </p>
    </div>
    <ul>
      <li>
        <strong>Основной текст идёт первым.</strong>
        Пояснения необязательны и раскрываются только по вашему выбору.
      </li>
      <li>
        <strong>Без спойлеров вперёд.</strong>
        Комментарий использует лишь сведения, доступные к текущим строкам.
      </li>
      <li>
        <strong>Место чтения запоминается на этом устройстве.</strong>
        Сайт предложит продолжить, но никогда не перенесёт вас молча.
      </li>
    </ul>
  </section>

  <section class="principles" aria-labelledby="principles-title">
    <p class="eyebrow">Редакционные принципы</p>
    <h2 id="principles-title">Близко к поэме — бережно к читателю</h2>
    <div class="principle-grid">
      <article>
        <span>01</span><h3>Без опережения</h3><p>
          Пояснения знают только то, что уже знает читатель в текущей строке.
        </p>
      </article>
      <article>
        <span>02</span><h3>Без чужого перевода</h3><p>
          Новая русская проза создаётся независимо; современные переводы не
          служат шаблоном.
        </p>
      </article>
      <article>
        <span>03</span><h3>С видимой неопределённостью</h3><p>
          Мир поэмы, исторический контекст и современные гипотезы не
          смешиваются.
        </p>
      </article>
      <article>
        <span>04</span><h3>С проверяемым следом</h3><p>
          Диапазоны строк, источники, права и редакционные решения доступны
          рядом с текстом.
        </p>
      </article>
    </div>
  </section>

  <section class="principles" aria-labelledby="explore-title">
    <p class="eyebrow">Навигация по поэме</p>
    <h2 id="explore-title">Читайте и исследуйте в своём темпе</h2>
    <div class="principle-grid">
      <article>
        <span>01</span><h3><a href={withBase("/read/")}>Все 24 песни</a></h3><p>
          Полное оглавление в исходном порядке, без сюжетных заголовков.
        </p>
      </article>
      <article>
        <span>02</span><h3><a href={withBase("/people/")}>Персонажи</a></h3><p>
          Справочник, который открывается вслед за прочитанными песнями.
        </p>
      </article>
      <article>
        <span>03</span><h3><a href={withBase("/glossary/")}>Словарь</a></h3><p>
          Термины гомеровского мира без преждевременного раскрытия сюжета.
        </p>
      </article>
      <article>
        <span>04</span><h3><a href={withBase("/sources/")}>Источники</a></h3><p>
          Первичный текст, научные комментарии и проверяемые библиографические
          карточки.
        </p>
      </article>
    </div>
  </section>

  <section class="quote-band">
    <p>
      «Это не воспроизведение какого-либо современного перевода и не
      академическое критическое издание».
    </p>
    <a href={withBase("/rights/")}>Подробнее о происхождении и правах →</a>
  </section>
</BaseLayout>

<script>
  const resumeLink =
    document.querySelector<HTMLAnchorElement>("[data-resume-link]");
  const lastBook = Number(
    localStorage.getItem("odyssey-last-book") ??
      localStorage.getItem("odyssey-max-book"),
  );
  if (resumeLink && lastBook >= 1 && lastBook <= 24) {
    const number = String(lastBook).padStart(2, "0");
    const passage = localStorage.getItem(`odyssey-progress-book-${number}`);
    const range = passage?.match(/^lines-(\d+)-(\d+)$/);
    const roman = [
      "I",
      "II",
      "III",
      "IV",
      "V",
      "VI",
      "VII",
      "VIII",
      "IX",
      "X",
      "XI",
      "XII",
      "XIII",
      "XIV",
      "XV",
      "XVI",
      "XVII",
      "XVIII",
      "XIX",
      "XX",
      "XXI",
      "XXII",
      "XXIII",
      "XXIV",
    ][lastBook - 1];
    resumeLink.href = `${resumeLink.dataset.bookBase}${number}/${passage ? `#${passage}` : ""}`;
    resumeLink.textContent = range
      ? `Продолжить: Песнь ${roman}, строки ${range[1]}–${range[2]}`
      : `Продолжить: Песнь ${roman}`;
  }
</script>
