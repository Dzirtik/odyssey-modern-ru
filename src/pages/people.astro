---
import YAML from "yaml";
import BaseLayout from "../layouts/BaseLayout.astro";
import ReferenceControls from "../components/ReferenceControls.astro";
import peopleText from "../data/people.yml?raw";
import { project, withBase } from "../data/project";

interface Person {
  name: string;
  type: string;
  first_book: number;
  aliases: string[];
  description: string;
}

const people = YAML.parse(peopleText) as Person[];
const breadcrumbs = [
  { name: "Главная", href: withBase("/") },
  { name: "Персонажи" },
];
---

<BaseLayout
  title="Персонажи «Одиссеи» Гомера"
  description="Безспойлерный справочник персонажей «Одиссеи» Гомера: Одиссей, Телемах, Пенелопа, Афина и другие герои по мере их появления."
  pageType="CollectionPage"
  dateModified={project.lastChecked}
  {breadcrumbs}
>
  <section class="page-intro">
    <p class="eyebrow" data-progress-label>Прогрессивный справочник</p>
    <h1>{people.length} персонажей и существ</h1>
    <p>
      Карточки открываются по мере чтения. Описание ограничено сведениями,
      которые нужны для ориентации в поэме; основа — <a
        href={withBase("/sources/#homer_odyssey_perseus_grc2")}
        >греческий текст</a
      > и <a href={withBase("/sources/#de_jong_2001")}>построчный комментарий</a
      >.
    </p>
  </section>
  <ReferenceControls />
  <div class="card-list">
    {
      people.map((person) => (
        <article
          data-reveal-book={person.first_book}
          data-nosnippet={person.first_book > 1 ? true : undefined}
          hidden={person.first_book > 1}
        >
          <p class="card-meta">
            {person.type} · впервые в Песни {person.first_book}
          </p>
          <h2>{person.name}</h2>
          {person.aliases.length > 0 && (
            <p class="card-aliases">Также: {person.aliases.join(", ")}.</p>
          )}
          <p>{person.description}</p>
        </article>
      ))
    }
  </div>
</BaseLayout>
