---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { project, withBase } from "../../data/project";
const books = Array.from({ length: 24 }, (_, index) => index + 1);
const romanBooks = [
  "I",
  "II",
  "III",
  "IV",
  "V",
  "VI",
  "VII",
  "VIII",
  "IX",
  "X",
  "XI",
  "XII",
  "XIII",
  "XIV",
  "XV",
  "XVI",
  "XVII",
  "XVIII",
  "XIX",
  "XX",
  "XXI",
  "XXII",
  "XXIII",
  "XXIV",
];
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const structuredData = [
  {
    "@type": "ItemList",
    "@id": `${canonicalURL.href}#books`,
    name: "Все 24 песни «Одиссеи» Гомера",
    numberOfItems: books.length,
    itemListOrder: "https://schema.org/ItemListOrderAscending",
    itemListElement: books.map((book, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(
        withBase(`/book/${String(book).padStart(2, "0")}/`),
        Astro.site ?? Astro.url,
      ).href,
      name: `Песнь ${romanBooks[index]}`,
    })),
  },
];
const breadcrumbs = [
  { name: "Главная", href: withBase("/") },
  { name: "Читать" },
];
---

<BaseLayout
  title="Читать «Одиссею» Гомера: все 24 песни"
  description="Оглавление всех 24 песен «Одиссеи» Гомера в современном русском прозаическом переложении с построчной сверкой и комментариями."
  pageType="CollectionPage"
  dateModified={project.lastChecked}
  {structuredData}
  {breadcrumbs}
>
  <section class="page-intro">
    <p class="eyebrow">Оглавление без спойлеров</p>
    <h1>Читать «Одиссею»: все 24 песни</h1>
    <p>
      Описательные названия скрыты. Песни расположены в исходном порядке поэмы.
    </p>
  </section>
  <section class="resume-panel" data-resume-panel hidden>
    <div>
      <p class="eyebrow">Ваше чтение</p>
      <h2 data-resume-title>Продолжить чтение</h2>
      <p>
        Место хранится только в браузере на этом устройстве. Вы сами решаете,
        продолжить или открыть песнь сначала.
      </p>
    </div>
    <div class="resume-actions">
      <a class="button primary" href={withBase("/book/01/")} data-resume-action>
        Продолжить
      </a>
      <a
        class="button secondary"
        href={withBase("/book/01/")}
        data-start-action
      >
        Начать песнь сначала
      </a>
      <button class="button secondary" type="button" data-reset-progress>
        Сбросить прогресс
      </button>
    </div>
  </section>
  <ol class="book-grid">
    {
      books.map((book) => {
        const number = String(book).padStart(2, "0");
        return (
          <li
            class="published"
            data-book-card={number}
            data-book-roman={romanBooks[book - 1]}
          >
            <a href={withBase(`/book/${number}/`)} data-book-link>
              <span>{number}</span>
              <h2>Песнь {romanBooks[book - 1]}</h2>
              <small data-card-progress hidden>
                Продолжить отсюда
              </small>
            </a>
          </li>
        );
      })
    }
  </ol>
</BaseLayout>

<script>
  import {
    readReaderState,
    resetReaderState,
  } from "../../scripts/reader-state";

  const panel = document.querySelector<HTMLElement>("[data-resume-panel]");
  const title = document.querySelector<HTMLElement>("[data-resume-title]");
  const resumeAction = document.querySelector<HTMLAnchorElement>(
    "[data-resume-action]",
  );
  const startAction = document.querySelector<HTMLAnchorElement>(
    "[data-start-action]",
  );
  const resetAction = document.querySelector<HTMLButtonElement>(
    "[data-reset-progress]",
  );
  const { lastBook, lastPassage } = readReaderState();

  if (panel && title && resumeAction && startAction && lastBook) {
    const number = String(lastBook).padStart(2, "0");
    const range = lastPassage?.match(/^lines-(\d+)-(\d+)$/);
    const card = document.querySelector<HTMLElement>(
      `[data-book-card="${number}"]`,
    );
    const cardLink = card?.querySelector<HTMLAnchorElement>("[data-book-link]");
    const marker = card?.querySelector<HTMLElement>("[data-card-progress]");
    const roman = card?.dataset.bookRoman ?? String(lastBook);
    const baseURL = cardLink?.href ?? startAction.href;
    const resumeURL = `${baseURL}${lastPassage ? `#${lastPassage}` : ""}`;

    title.textContent = range
      ? `Продолжить Песнь ${roman}, строки ${range[1]}–${range[2]}`
      : `Продолжить Песнь ${roman}`;
    resumeAction.href = resumeURL;
    startAction.href = baseURL;
    if (cardLink) cardLink.href = resumeURL;
    card?.classList.add("is-current");
    cardLink?.setAttribute("aria-current", "step");
    if (marker) marker.hidden = false;
    panel.hidden = false;
  }

  resetAction?.addEventListener("click", () => {
    if (
      !confirm(
        "Сбросить сохранённое место чтения и предел открытого справочника на этом устройстве?",
      )
    ) {
      return;
    }
    resetReaderState();
    location.reload();
  });
</script>
