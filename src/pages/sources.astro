---
import YAML from "yaml";
import BaseLayout from "../layouts/BaseLayout.astro";
import sourcesText from "../data/sources.yml?raw";

const sources = YAML.parse(sourcesText);

const typeLabels: Record<string, string> = {
  primary: "Первичный текст",
  critical_edition: "Издание и комментарий",
  lexicon: "Словарь",
  article: "Научная статья",
  monograph: "Монография или глава",
  museum: "Музейный ресурс",
  official: "Официальный документ",
  reference: "Справочная навигация",
};
---

<BaseLayout title="Источники">
  <section class="page-intro">
    <p class="eyebrow">Рабочая академическая библиография</p>
    <h1>{sources.length} документированных источников</h1>
    <p>
      Библиография отделяет первичный текст, словари, старые комментарии,
      современную науку и справочную навигацию. Наличие карточки не означает
      согласия со всеми выводами автора: спорные интерпретации помечаются и
      сопоставляются.
    </p>
    <p>
      На сайте не публикуются локальные копии книг и статей. Для каждого
      цифрового объекта указан режим использования и отдельный правовой статус.
    </p>
  </section>

  <div class="source-list">
    {sources.map((source: any) => (
      <article id={source.id}>
        <p class="eyebrow">{typeLabels[source.source_type] ?? source.source_type}</p>
        <h2>{source.author}. {source.title}</h2>
        <p>
          {source.institution_or_publisher}
          {source.year ? `, ${source.year}` : ""}
          {source.edition ? `. ${source.edition}` : ""}
          {source.pages_or_lines ? `. ${source.pages_or_lines}` : ""}.
        </p>
        <p>
          <a href={source.url}>Открыть источник</a>
          {" · "}
          дата обращения: {source.accessed_at}
        </p>
        <p class="source-meta">
          Работа: {source.work_rights_status}; цифровой объект:{" "}
          {source.digital_object_rights_status}; использование в проекте:{" "}
          {source.allowed_use}.
          {source.license_name ? ` Лицензия/условия: ${source.license_name}.` : ""}
        </p>
        <p>{source.notes}</p>
      </article>
    ))}
  </div>
</BaseLayout>
